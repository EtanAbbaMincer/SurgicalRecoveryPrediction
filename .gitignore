# =====================================================================
# All of Us DUA: ONLY plain code may be committed. NO data, ever.
# Therefore: deny by default, whitelist code + Claude files + notebooks.
# =====================================================================

# Ignore everything...
*

# ...but descend into directories so the whitelists below can be evaluated.
# (Without this, git never looks inside a directory to find allowed files.)
!*/

# --- Allowed: repo + Claude config ---
!/.gitignore
!/CLAUDE.md
!/.claude/
!/.claude/**
!**/*.md

# --- Allowed: plain code ---
!**/*.ipynb
!**/*.py
!**/*.sql
!**/*.R
!**/*.r

# --- Allowed: environment declarations ---
!/requirements.txt
!/environment.yml
!/pyproject.toml

# --- Allowed: git plumbing that ENFORCES this policy (must stay committed) ---
!/.gitattributes
!/.githooks/
!/.githooks/**

# =====================================================================
# Re-ignored AFTER the whitelists (last match wins), because these hold
# data or derived output regardless of what extension is inside them.
# =====================================================================

# Per-notebook figure output folders need no rule of their own: the deny-by-default
# `*` above already hides them, and image extensions are denied again below.

# Query caches / materialized extracts
_cache/
.cache/

# Belt-and-braces: data file types, in case a whitelist is ever widened
*.csv
*.tsv
*.parquet
*.feather
*.xlsx
*.dta
*.sav
*.db
*.sqlite
*.pkl
*.pickle
*.npy
*.npz
*.h5
*.hdf5
*.json

# Credentials
.env
*.key
*.pem
.credentials.json

# Python / Jupyter noise
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
.DS_Store

# =====================================================================
# Suppressed figures ARE committable.
#
# All of Us dissemination policy permits aggregate results that meet the small-cell
# threshold to leave the workspace, so a figure whose every cell clears it is not
# "data" in the sense the DUA prohibits. Only the *_suppressed.* variants qualify:
# that name is written solely by the suppress=True plotting path, which aggregates the
# sparse tail into a bucket meeting the threshold.
#
# Unsuppressed working figures stay ignored. They are the ones that can carry a cell
# under the threshold, and a PNG cannot be reviewed in a diff or removed from history
# after a push.
#
# These patterns contain NO slash, so they match at any depth and keep working if the
# directory layout changes. Do not add a path to them.
# =====================================================================
!*_suppressed.png
!*_suppressed.svg
!*_suppressed.pdf

# =====================================================================
# Final override: Claude project config stays tracked even though the
# data-type denials above (notably *.json) would otherwise catch it.
# Last match wins, so this must remain the LAST block in this file.
# Do not put data files under .claude/.
# =====================================================================
!/.claude/
!/.claude/**

# ...except worktrees: EnterWorktree/forks create full repo checkouts under here, and
# .claude/** would otherwise make them committable.
/.claude/worktrees/
